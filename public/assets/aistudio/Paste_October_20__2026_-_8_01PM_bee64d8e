        {/* Meta */}
        <div className="flex items-center justify-between text-sm text-gray-500">
          <div className="flex items-center gap-2">
            <Eye size={16} />
            <span>{fmtCount(story.views_count || 0)} views</span>
          </div>
          <div className="flex items-center gap-2">
            <Clock size={16} />
            <span>Expires {new Date(story.expires_at).toLocaleDateString()}</span>
          </div>
        </div>

        {/* CTA buttons */}
        <div className="flex gap-3">
          <button
            onClick={() => navigate('/')}
            className="flex-1 py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm uppercase tracking-wider transition-colors"
          >
            Explore Jobs
          </button>
          <button
            onClick={async () => {
              if (navigator.share) {
                try { await navigator.share({ title, url: storyUrl }); } catch {}
              } else {
                await navigator.clipboard.writeText(storyUrl);
                alert('Link copied!');
              }
            }}
            className="px-6 py-3 rounded-xl bg-white/5 hover:bg-white/10 text-white font-bold text-sm uppercase tracking-wider transition-colors flex items-center gap-2"
          >
            <Share2 size={16} /> Share
          </button>
        </div>
      </div>

      {/* ─── FULL-SCREEN VIEWER ─── */}
      {viewerOpen && (
        <StoryViewer
          story={story}
          user={viewingUser}
          currentUser={currentUser}
          allStories={[story]}
          onClose={() => setViewerOpen(false)}
          onViewRecorded={(id) => {
            setStory((prev) =>
              prev && prev.id === id
                ? { ...prev, views_count: (prev.views_count || 0) + 1 }
                : prev
            );
          }}
          onProfileClick={(id) => navigate(`/u/${id}`)}
        />
      )}
    </>
  );
};

// ============================================================
// MAIN PAGE — Story feed (/stories route)
// ============================================================
export default function StoryPage() {
  const { user: authUser } = useUserAuth();
  const navigate = useNavigate();

  const currentUser: StoryUser | null = authUser
    ? {
        id: String(authUser.id),
        name: authUser.name || authUser.username || 'User',
        username: authUser.username || null,
        email: authUser.email,
        profile_image_url: authUser.profile_image_url || null,
        is_verified: (authUser as any).is_verified || 0,
      }
    : null;

  const [stories, setStories] = useState<StoryType[]>([]);
  const [loading, setLoading] = useState(true);
  const [createOpen, setCreateOpen] = useState(false);
  const [viewingStory, setViewingStory] = useState<StoryType | null>(null);

  const loadStories = useCallback(async () => {
    try {
      const data = await apiFetch('/api/stories');
      const list = Array.isArray(data?.stories) ? data.stories : Array.isArray(data) ? data : [];
      setStories(list.filter((s: StoryType) => !isExpired(s)));
    } catch (err) {
      console.error('Failed to load stories:', err);
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    loadStories();
  }, [loadStories]);

  const handleCreate = async (payload: CreateStoryPayload) => {
    await apiFetch('/api/stories', {
      method: 'POST',
      body: JSON.stringify(payload),
    });
    await loadStories();
  };

  const handleDelete = async (storyId: string) => {
    await apiFetch(`/api/stories/${encodeURIComponent(storyId)}`, { method: 'DELETE' });
    setStories((prev) => prev.filter((s) => s.id !== storyId));
  };

  const handleViewRecorded = (storyId: string) => {
    setStories((prev) =>
      prev.map((s) =>
        s.id === storyId ? { ...s, views_count: (s.views_count || 0) + 1 } : s
      )
    );
  };

  const viewingUser: StoryUser | null = viewingStory
    ? viewingStory.user || {
        id: viewingStory.user_id,
        name: 'User',
        profile_image_url: getDefaultAvatar('User', viewingStory.user_id),
        is_verified: 0,
      }
    : null;

  return (
    <>
      <SEO
        title="Job Stories | JobsReport"
        description="Real job success stories and career insights shared by the JobsReport community."
      />

      <div className="max-w-5xl mx-auto px-4 py-6 space-y-8">
        <div>
          <h1 className="text-3xl font-black text-white mb-2">Job Stories</h1>
          <p className="text-gray-400 text-sm">
            Real stories from job seekers and professionals. Share yours.
          </p>
        </div>

        <StoryReel
          stories={stories}
          loading={loading}
          onProfileClick={(id) => navigate(`/u/${id}`)}
          onCreateStory={() => setCreateOpen(true)}
          onViewStory={(s) => setViewingStory(s)}
          currentUser={currentUser}
          onRequestLogin={() => navigate('/login')}
        />

        {stories.length === 0 && !loading && (
          <div className="text-center py-16 text-gray-500 text-sm font-mono">
            No active stories yet. Be the first to share one.
          </div>
        )}

        <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
          {stories.map((s) => (
            <button
              key={s.id}
              onClick={() => setViewingStory(s)}
              className="relative aspect-[9/16] rounded-2xl overflow-hidden border border-white/5 bg-white/[0.01] hover:border-blue-500/30 transition-all text-left"
            >
              {s.type === 'text' ? (
                <div
                  className="absolute inset-0 p-3 flex items-center justify-center text-center"
                  style={{ background: s.background_style || '#0B1120' }}
                >
                  <span className="text-white text-xs font-bold line-clamp-6">
                    {s.text_content}
                  </span>
                </div>
              ) : (
                <img
                  src={s.media_thumb || s.media_url || ''}
                  alt=""
                  className="absolute inset-0 w-full h-full object-cover"
                  loading="lazy"
                />
              )}
              <div className="absolute bottom-0 left-0 right-0 p-2 bg-gradient-to-t from-black/80 to-transparent">
                <p className="text-white text-[10px] font-bold truncate flex items-center gap-1">
                  <span className="truncate">{s.user?.name || 'User'}</span>
                  {s.user?.is_verified === 1 && <VerifiedBadge size={9} />}
                </p>
                <p className="text-white/60 text-[9px] flex items-center gap-1">
                  <Eye size={9} /> {fmtCount(s.views_count || 0)}
                </p>
              </div>
            </button>
          ))}
        </div>
      </div>

      {createOpen && currentUser && (
        <CreateStoryModal
          currentUser={currentUser}
          onClose={() => setCreateOpen(false)}
          onCreate={handleCreate}
        />
      )}

      {viewingStory && viewingUser && (
        <StoryViewer
          story={viewingStory}
          user={viewingUser}
          currentUser={currentUser}
          allStories={stories}
          onClose={() => setViewingStory(null)}
          onNext={() => {
            const idx = stories.findIndex((s) => s.id === viewingStory.id);
            const next = stories[idx + 1];
            if (next) setViewingStory(next);
            else setViewingStory(null);
          }}
          onPrev={() => {
            const idx = stories.findIndex((s) => s.id === viewingStory.id);
            const prev = stories[idx - 1];
            if (prev) setViewingStory(prev);
            else setViewingStory(null);
          }}
          onProfileClick={(id) => navigate(`/u/${id}`)}
          onDeleteStory={handleDelete}
          onViewRecorded={handleViewRecorded}
        />
      )}
    </>
  );
}