interface CreateStoryModalProps {
  currentUser: StoryUser;
  onClose: () => void;
  onCreate: (payload: CreateStoryPayload) => Promise<void> | void;
}

export const CreateStoryModal: React.FC<CreateStoryModalProps> = ({
  currentUser,
  onClose,
  onCreate,
}) => {
  const [mode, setMode] = useState<'text' | 'image'>('text');
  const [text, setText] = useState('');
  const [background, setBackground] = useState(STORY_BACKGROUNDS[0]);
  const [imageUrl, setImageUrl] = useState<string | null>(null);
  const [imageThumb, setImageThumb] = useState<string | null>(null);
  const [uploading, setUploading] = useState(false);
  const [creating, setCreating] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const defaultDeadline = useMemo(() => {
    const d = new Date();
    d.setDate(d.getDate() + 7);
    return d.toISOString().split('T')[0];
  }, []);
  const [deadline, setDeadline] = useState(defaultDeadline);

  const fileInputRef = useRef<HTMLInputElement>(null);

  const canShare =
    (mode === 'text' && text.trim().length > 0) ||
    (mode === 'image' && !!imageUrl);

  const handleFileUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    e.currentTarget.value = '';
    if (!file) return;

    if (!file.type.startsWith('image/')) {
      setError('Please select an image file');
      return;
    }
    if (file.size > 8 * 1024 * 1024) {
      setError('Image must be under 8MB');
      return;
    }

    setError(null);
    setUploading(true);
    try {
      const thumbFile = await generateThumbnail(file);

      const fd = new FormData();
      fd.append('file', file);
      if (thumbFile) fd.append('thumbnail', thumbFile);
      fd.append('name', file.name);
      fd.append('altText', `Story by ${currentUser.name}`);

      const res = await fetch('/api/upload', { method: 'POST', body: fd });
      const data = await res.json().catch(() => null);

      if (!res.ok) {
        throw new Error(data?.error || 'Upload failed');
      }

      const url = data?.url || data?.dataUrl;
      const thumb = data?.thumbnail_url || url;

      if (!url) throw new Error('No URL returned from upload');

      setImageUrl(url);
      setImageThumb(thumb);
      setMode('image');
    } catch (err: any) {
      setError(err?.message || 'Upload failed');
    } finally {
      setUploading(false);
    }
  };

  const handleCreate = async () => {
    if (!canShare || creating) return;
    setCreating(true);
    setError(null);

    try {
      const expiresIso = new Date(deadline + 'T23:59:59').toISOString();

      const payload: CreateStoryPayload = {
        type: mode,
        text_content: mode === 'text' ? text.trim() : null,
        background_style: mode === 'text' ? background : null,
        media_url: mode === 'image' ? imageUrl : null,
        media_thumb: mode === 'image' ? imageThumb : null,
        expires_at: expiresIso,
      };

      await onCreate(payload);
      onClose();
    } catch (err: any) {
      setError(err?.message || 'Failed to create story');
    } finally {
      setCreating(false);
    }
  };

  return (
    <div className="fixed inset-0 z-[200] bg-[#050B18] flex flex-col text-white overflow-hidden animate-fade-in">
      <div className="flex justify-between items-center p-4 bg-[#0B1120] border-b border-[#1E293B]">
        <button
          onClick={onClose}
          className="text-white font-bold text-sm bg-[#1E293B] px-4 py-2 rounded-full hover:bg-[#141E33] border border-[#1E293B] transition-all"
        >
          Discard
        </button>
        <h3 className="font-black text-[18px]">Create Story</h3>
        <button
          onClick={handleCreate}
          disabled={!canShare || creating || uploading}
          className="bg-[#1877F2] text-white px-6 py-2 rounded-full font-black text-sm disabled:opacity-50 disabled:bg-gray-600 transition-all"
        >
          {creating ? <Loader2 size={16} className="animate-spin inline" /> : 'Share'}
        </button>
      </div>

      <div
        className="flex-1 flex items-center justify-center relative overflow-hidden"
        style={{ background: mode === 'text' ? background : '#050B18' }}
      >
        {mode === 'text' ? (
          <textarea
            autoFocus
            placeholder="Share your job story... (links welcome)"
            value={text}
            onChange={(e) => setText(e.target.value)}
            className="bg-transparent text-white text-2xl sm:text-3xl font-bold text-center w-full max-w-lg outline-none resize-none placeholder-white/40 px-8 h-[40vh]"
          />
        ) : imageUrl ? (
          <div className="relative w-full h-full">
            <img src={imageUrl} alt="Story" className="w-full h-full object-contain" />
            <button
              onClick={() => { setImageUrl(null); setImageThumb(null); }}
              className="absolute top-4 left-4 w-10 h-10 bg-black/50 rounded-full flex items-center justify-center text-white hover:bg-black/70"
              aria-label="Remove image"
            >
              <Trash2 size={18} />
            </button>
          </div>
        ) : (
          <div
            className="text-center cursor-pointer group"
            onClick={() => fileInputRef.current?.click()}
          >
            <div className="w-20 h-20 bg-[#0F172A] border border-[#1E293B] rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-[#1E293B] transition-all">
              {uploading ? <Loader2 size={28} className="text-white animate-spin" /> : <ImageIcon size={28} className="text-white" />}
            </div>
            <p className="font-black text-xl text-white">
              {uploading ? 'Processing…' : 'Select an Image'}
            </p>
            <p className="text-white/60 text-sm mt-2">
              JPG, PNG, WEBP — max 8MB
            </p>
          </div>
        )}

        <input
          type="file"
          ref={fileInputRef}
          className="hidden"
          accept="image/*"
          onChange={handleFileUpload}
        />
      </div>

      <div className="bg-[#0B1120] border-t border-[#1E293B] p-4 flex flex-col gap-4">
        {mode === 'text' && (
          <div className="flex gap-3 overflow-x-auto scrollbar-hide px-2 py-1">
            {STORY_BACKGROUNDS.map((col, idx) => (
              <button
                key={idx}
                onClick={() => setBackground(col)}
                className={`w-9 h-9 rounded-full flex-shrink-0 border-2 transition-transform hover:scale-110 ${
                  background === col ? 'border-white scale-110 shadow-[0_0_15px_rgba(255,255,255,0.3)]' : 'border-transparent'
                }`}
                style={{ background: col }}
                aria-label={`Background ${idx + 1}`}
              />
            ))}
          </div>
        )}

        <div className="flex items-center justify-between gap-3 px-2 py-2 rounded-2xl bg-[#070D1D] border border-[#1E293B]">
          <div className="flex items-center gap-2 text-white/80">
            <Calendar size={16} />
            <span className="text-sm font-bold">Deadline</span>
          </div>
          <input
            type="date"
            value={deadline}
            min={new Date().toISOString().split('T')[0]}
            onChange={(e) => setDeadline(e.target.value)}
            className="bg-[#0F172A] border border-[#1E293B] text-white text-sm rounded-xl px-3 py-2 outline-none focus:border-[#1877F2]"
          />
        </div>

        <div className="flex items-center justify-between px-2">
          <div className="flex gap-2 bg-[#070D1D] p-1 rounded-2xl border border-[#1E293B]">
            <button
              onClick={() => setMode('text')}
              className={`px-5 py-2.5 rounded-xl text-sm font-black transition-all flex items-center gap-2 ${
                mode === 'text' ? 'bg-[#1877F2] text-white shadow-lg' : 'text-white/60'
              }`}
            >
              <Type size={14} /> Text
            </button>
            <button
              onClick={() => setMode('image')}
              className={`px-5 py-2.5 rounded-xl text-sm font-black transition-all flex items-center gap-2 ${
                mode === 'image' ? 'bg-[#1877F2] text-white shadow-lg' : 'text-white/60'
              }`}
            >
              <ImageIcon size={14} /> Image
            </button>
          </div>

          <button
            onClick={() => fileInputRef.current?.click()}
            disabled={uploading}
            className="w-12 h-12 rounded-full flex items-center justify-center transition-all bg-white/10 text-white/80 hover:bg-white/20"
            aria-label="Add image"
          >
            <Plus size={18} />
          </button>
        </div>

        {error && (
          <div className="flex items-center gap-2 px-3 py-2 rounded-xl bg-red-500/10 border border-red-500/20">
            <AlertCircle size={14} className="text-red-400 shrink-0" />
            <p className="text-xs text-red-400">{error}</p>
          </div>
        )}
      </div>
    </div>
  );
};

