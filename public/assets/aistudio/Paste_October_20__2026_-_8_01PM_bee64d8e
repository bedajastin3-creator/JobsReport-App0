// ============================================================
// HELPERS
// ============================================================
const parseServerTime = (value?: string): number => {
  const s = String(value ?? '').trim();
  if (!s) return Date.now();
  if (/[zZ]|[+-]\d{2}:?\d{2}$/.test(s)) {
    const t = Date.parse(s);
    return Number.isFinite(t) ? t : Date.now();
  }
  if (/^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}/.test(s)) {
    const iso = s.replace(' ', 'T') + 'Z';
    const t = Date.parse(iso);
    return Number.isFinite(t) ? t : Date.now();
  }
  const t = Date.parse(s);
  return Number.isFinite(t) ? t : Date.now();
};

const formatStoryTime = (created_at?: string): string => {
  const t = parseServerTime(created_at);
  const diff = Date.now() - t;
  if (diff < 60_000) return 'Just now';
  if (diff < 3_600_000) return `${Math.floor(diff / 60_000)}min`;
  if (diff < 86_400_000) return `${Math.floor(diff / 3_600_000)}hrs`;
  return `${Math.floor(diff / 86_400_000)}days`;
};

const fmtCount = (n: number) => {
  const num = Number(n || 0);
  if (num >= 1_000_000) return (num / 1_000_000).toFixed(1) + 'M';
  if (num >= 1_000) return (num / 1_000).toFixed(1) + 'K';
  return String(num);
};

const getDefaultAvatar = (name: string, seed: string | number) => {
  const colors = ['1877F2', '45BD62', 'F3425F', 'F7B928', '9360F7'];
  const hash = String(seed).split('').reduce((a, c) => a + c.charCodeAt(0), 0);
  const c = colors[Math.abs(hash) % colors.length];
  const init = (name || 'U').slice(0, 1).toUpperCase();
  return `https://ui-avatars.com/api/?name=${encodeURIComponent(init)}&background=${c}&color=fff&size=128&bold=true&rounded=true`;
};

const isExpired = (story: StoryType): boolean => {
  if (story.is_active === 0 || story.is_active === (false as any)) return true;
  if (!story.expires_at) return false;
  return parseServerTime(story.expires_at) < Date.now();
};

// ============================================================
// CLIENT-SIDE THUMBNAIL GENERATION
// ============================================================
const generateThumbnail = async (file: File): Promise<File | null> => {
  try {
    const objectUrl = URL.createObjectURL(file);
    const img = await new Promise<HTMLImageElement>((resolve, reject) => {
      const i = new Image();
      i.onload = () => resolve(i);
      i.onerror = () => reject(new Error('Image load failed'));
      i.src = objectUrl;
    });
    URL.revokeObjectURL(objectUrl);

    const scale = Math.min(1, THUMB_MAX_DIMENSION / Math.max(img.width, img.height));
    const w = Math.max(1, Math.round(img.width * scale));
    const h = Math.max(1, Math.round(img.height * scale));

    const canvas = document.createElement('canvas');
    canvas.width = w;
    canvas.height = h;
    const ctx = canvas.getContext('2d');
    if (!ctx) return null;
    ctx.drawImage(img, 0, 0, w, h);

    const blob: Blob | null = await new Promise((resolve) => {
      canvas.toBlob((b) => resolve(b), 'image/webp', THUMB_QUALITY);
    });

    if (!blob) return null;

    const baseName = file.name.replace(/\.[^.]+$/, '');
    return new File([blob], `${baseName}-thumb.webp`, { type: 'image/webp' });
  } catch (err) {
    console.warn('[thumbnail] generation failed:', err);
    return null;
  }
};

// ============================================================
// LINKIFY
// ============================================================
const URL_REGEX = /((?:https?:\/\/|www\.)[^\s<>"']+|[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,})/gi;

export const Linkify: React.FC<{ text: string; className?: string }> = ({ text, className }) => {
  const parts = useMemo(() => {
    const out: Array<{ type: 'text' | 'link'; value: string; href?: string }> = [];
    let lastIndex = 0;
    const safe = String(text ?? '');
    safe.replace(URL_REGEX, (match, _g1, offset: number) => {
      if (offset > lastIndex) {
        out.push({ type: 'text', value: safe.slice(lastIndex, offset) });
      }
      const isEmail = /^[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$/i.test(match);
      const href = isEmail
        ? `mailto:${match}`
        : match.startsWith('http')
          ? match
          : `https://${match}`;
      out.push({ type: 'link', value: match, href });
      lastIndex = offset + match.length;
      return match;
    });
    if (lastIndex < safe.length) {
      out.push({ type: 'text', value: safe.slice(lastIndex) });
    }
    return out;
  }, [text]);

  return (
    <span className={className}>
      {parts.map((p, i) =>
        p.type === 'link' ? (
          <a
            key={i}
            href={p.href}
            target="_blank"
            rel="noopener noreferrer"
            className="text-blue-300 underline underline-offset-2 hover:text-blue-200 break-all"
            onClick={(e) => e.stopPropagation()}
          >
            {p.value}
          </a>
        ) : (
          <React.Fragment key={i}>{p.value}</React.Fragment>
        )
      )}
    </span>
  );
};

// ============================================================
// API HELPERS
// ============================================================
const apiFetch = async (url: string, options: RequestInit = {}) => {
  const token = getToken();
  const headers: Record<string, string> = {
    'Content-Type': 'application/json',
    ...(options.headers as Record<string, string> | undefined),
  };
  if (token) headers['Authorization'] = `Bearer ${token}`;

  const res = await fetch(url, { ...options, headers });
  const data = await res.json().catch(() => ({}));
  if (!res.ok) {
    throw new Error((data as any)?.error || `Request failed (${res.status})`);
  }
  return data;
};

// ============================================================
// STORY VIEWER — full screen
// ============================================================
interface StoryViewerProps {
  story: StoryType;
  user: StoryUser;
  currentUser: StoryUser | null;
  onClose: () => void;
  onNext?: () => void;
  onPrev?: () => void;
  allStories?: StoryType[];
  onProfileClick?: (id: string) => void;
  onDeleteStory?: (storyId: string) => Promise<void> | void;
  deleteLoading?: boolean;
  onViewRecorded?: (storyId: string) => void;
}

export const StoryViewer: React.FC<StoryViewerProps> = ({
  story,
  user,
  currentUser,
  onClose,
  onNext,
  onPrev,
  allStories = [],
  onProfileClick,
  onDeleteStory,
  deleteLoading = false,
  onViewRecorded,
}) => {
  const navigate = useNavigate();
  const [progress, setProgress] = useState(0);
  const [isPaused, setIsPaused] = useState(false);
  const [mediaReady, setMediaReady] = useState(false);
  const [originalLoaded, setOriginalLoaded] = useState(false);
  const [showDeleteConfirm, setShowDeleteConfirm] = useState(false);
  const [deletingStory, setDeletingStory] = useState(false);
  const [copied, setCopied] = useState(false);

  const progressIntervalRef = useRef<number | null>(null);
  const lastNavAtRef = useRef(0);
  const didAdvanceRef = useRef(false);
  const pointerDownRef = useRef<{ x: number; y: number; t: number } | null>(null);
  const viewRecordedRef = useRef<string | null>(null);

  const isAuthor = !!currentUser && String(currentUser.id) === String(user.id);

  const handleProfileClick = useCallback(() => {
    if (onProfileClick) {
      onProfileClick(user.id);
    } else {
      navigate(`/u/${user.id}`);
    }
  }, [onProfileClick, user.id, navigate]);

  const userStories = useMemo(() => {
    const src = allStories.length ? allStories : [story];
    return src
      .filter((s) => String(s.user_id) === String(story.user_id))
      .slice()
      .sort((a, b) => parseServerTime(b.created_at) - parseServerTime(a.created_at));
  }, [allStories, story]);

  const currentIndex = userStories.findIndex((s) => String(s.id) === String(story.id));

  const storyIsText = story.type === 'text';
  const originalUrl = story.media_url || '';
  const thumbUrl = story.media_thumb || originalUrl;
  const displayUrl = originalLoaded && originalUrl ? originalUrl : thumbUrl;

  useEffect(() => {
    if (viewRecordedRef.current === story.id) return;
    viewRecordedRef.current = story.id;
    apiFetch(`/api/stories/${encodeURIComponent(story.id)}/view`, { method: 'POST' })
      .then(() => onViewRecorded?.(story.id))
      .catch(() => {});
  }, [story.id, onViewRecorded]);

  useEffect(() => {
    didAdvanceRef.current = false;
    setProgress(0);
    setMediaReady(storyIsText);
    setOriginalLoaded(false);
    if (progressIntervalRef.current) {
      clearInterval(progressIntervalRef.current);
      progressIntervalRef.current = null;
    }
  }, [story.id, storyIsText]);

  useEffect(() => {
    if (storyIsText || !thumbUrl) {
      setMediaReady(true);
      return;
    }
    const img = new Image();
    img.src = thumbUrl;
    const done = () => setMediaReady(true);
    if (img.complete) done();
    else {
      img.onload = done;
      img.onerror = done;
    }
  }, [story.id, storyIsText, thumbUrl]);

  useEffect(() => {
    if (storyIsText || !originalUrl || originalUrl === thumbUrl) return;
    const img = new Image();
    img.src = originalUrl;
    const done = () => setOriginalLoaded(true);
    if (img.complete) done();
    else {
      img.onload = done;
    }
  }, [story.id, storyIsText, originalUrl, thumbUrl]);

  const safeNavigate = useCallback((dir: 'next' | 'prev') => {
    const now = Date.now();
    if (now - lastNavAtRef.current < 600) return;
    lastNavAtRef.current = now;
    if (dir === 'next' && onNext) onNext();
    else if (dir === 'prev' && onPrev) onPrev();
  }, [onNext, onPrev]);

  useEffect(() => {
    if (!mediaReady) return;
    setProgress(0);
    didAdvanceRef.current = false;

    const tickMs = 50;
    const duration = DEFAULT_STORY_DURATION_MS;

    if (progressIntervalRef.current) clearInterval(progressIntervalRef.current);

    progressIntervalRef.current = window.setInterval(() => {
      if (isPaused) return;
      setProgress((prev) => {
        if (prev >= 100) return 100;
        const next = Math.min(100, prev + (100 / (duration / tickMs)));
        if (next >= 100 && !didAdvanceRef.current) {
          didAdvanceRef.current = true;
          safeNavigate('next');
        }
        return next;
      });
    }, tickMs);

    return () => {
      if (progressIntervalRef.current) {
        clearInterval(progressIntervalRef.current);
        progressIntervalRef.current = null;
      }
    };
  }, [story.id, isPaused, mediaReady, safeNavigate]);

  useEffect(() => {
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'ArrowRight' || e.key === ' ') { e.preventDefault(); safeNavigate('next'); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); safeNavigate('prev'); }
      else if (e.key === 'Escape') { e.preventDefault(); onClose(); }
      else if (e.key === 'p' || e.key === 'P') { e.preventDefault(); setIsPaused((p) => !p); }
    };
    window.addEventListener('keydown', onKey);
    return () => window.removeEventListener('keydown', onKey);
  }, [safeNavigate, onClose]);

  const isInteractiveTarget = (el: EventTarget | null) => {
    const node = el as HTMLElement | null;
    if (!node) return false;
    return !!node.closest('button,a,input,textarea,select,[role="button"],[data-no-nav="true"]');
  };

  const handlePointerDown = (e: React.PointerEvent) => {
    if (isInteractiveTarget(e.target)) return;
    pointerDownRef.current = { x: e.clientX, y: e.clientY, t: Date.now() };
  };

  const handlePointerUp = (e: React.PointerEvent) => {
    const start = pointerDownRef.current;
    pointerDownRef.current = null;
    if (!start) return;
    if (isInteractiveTarget(e.target)) return;

    const dx = e.clientX - start.x;
    const dy = e.clientY - start.y;
    const dt = Date.now() - start.t;

    if (Math.abs(dx) > 40 && Math.abs(dy) < 28) {
      if (dx < 0) safeNavigate('next'); else safeNavigate('prev');
      return;
    }
    const TAP_MOVE = 12;
    const TAP_TIME = 350;
    if (Math.abs(dx) <= TAP_MOVE && Math.abs(dy) <= TAP_MOVE && dt <= TAP_TIME) {
      const box = (e.currentTarget as HTMLElement).getBoundingClientRect();
      const ratio = (e.clientX - box.left) / box.width;
      if (ratio < 0.35) safeNavigate('prev');
      else if (ratio > 0.65) safeNavigate('next');
      else setIsPaused((p) => !p);
    }
  };

  const handleShare = async () => {
    const url = `${window.location.origin}/story/${story.slug}`;
    const shareData = {
      title: story.text_content?.slice(0, 80) || `${user.name}'s Story`,
      text: story.text_content?.slice(0, 160) || `Check out this story on JobsReport`,
      url,
    };
    if (navigator.share) {
      try { await navigator.share(shareData); return; } catch {}
    }
    try {
      await navigator.clipboard.writeText(url);
      setCopied(true);
      setTimeout(() => setCopied(false), 2000);
    } catch {
      window.prompt('Copy this link:', url);
    }
  };

  const handleDeleteStory = async () => {
    if (!onDeleteStory || !isAuthor) return;
    setDeletingStory(true);
    try {
      await onDeleteStory(story.id);
      setShowDeleteConfirm(false);
      setTimeout(() => onClose(), 250);
    } catch (err) {
      console.error('Delete failed:', err);
    } finally {
      setDeletingStory(false);
    }
  };

  const totalViews = story.views_count || 0;

  return (
    <div className="fixed inset-0 z-[250] bg-[#050B18] flex items-center justify-center animate-fade-in">
      <button
        className="absolute top-4 right-4 z-[300] w-10 h-10 flex items-center justify-center bg-[#0F172A]/80 hover:bg-[#1E293B] border border-[#1E293B] rounded-full transition-colors"
        onClick={(e) => { e.stopPropagation(); onClose(); }}
        aria-label="Close"
      >
        <X size={20} className="text-[#F8FAFC]" />
      </button>

      <div
        className="relative w-full h-full max-w-[480px] bg-[#0B1120] sm:rounded-2xl sm:border sm:border-[#1E293B] sm:shadow-2xl overflow-hidden flex flex-col touch-none"
        style={{ touchAction: 'none', overscrollBehavior: 'contain' }}
        onPointerDown={handlePointerDown}
        onPointerUp={handlePointerUp}
      >
        <button
          type="button"
          aria-label="Previous"
          className="absolute left-2 top-1/2 -translate-y-1/2 z-[120] w-10 h-10 rounded-full bg-white/10 hover:bg-white/15 backdrop-blur-md flex items-center justify-center"
          onClick={(e) => { e.stopPropagation(); safeNavigate('prev'); }}
          onPointerDown={(e) => e.stopPropagation()}
        >
          <ChevronLeft size={20} className="text-white/90" />
        </button>
        <button
          type="button"
          aria-label="Next"
          className="absolute right-2 top-1/2 -translate-y-1/2 z-[120] w-10 h-10 rounded-full bg-white/10 hover:bg-white/15 backdrop-blur-md flex items-center justify-center"
          onClick={(e) => { e.stopPropagation(); safeNavigate('next'); }}
          onPointerDown={(e) => e.stopPropagation()}
        >
          <ChevronRight size={20} className="text-white/90" />
        </button>

        <div className="absolute top-0 left-0 right-0 pt-2 px-3 z-30 flex gap-1.5">
          {userStories.map((_, i) => (
            <div key={i} className="h-1 bg-white/20 flex-1 rounded-full overflow-hidden">
              <div
                className="h-full bg-white transition-all duration-75 ease-linear"
                style={{
                  width: i < currentIndex ? '100%' : i === currentIndex ? `${progress}%` : '0%',
                }}
              />
            </div>
          ))}
        </div>

        <div
          className="absolute top-0 left-0 right-0 px-4 pt-6 pb-4 z-30 flex items-center justify-between bg-gradient-to-b from-[#0B1120]/90 via-[#0B1120]/40 to-transparent"
          data-no-nav="true"
        >
          <button
            onClick={(e) => { e.stopPropagation(); handleProfileClick(); }}
            className="flex items-center gap-3 hover:opacity-90 transition-opacity"
            aria-label={`View ${user.name}'s profile`}
          >
            <img
              src={user.profile_image_url || getDefaultAvatar(user.name, user.id)}
              alt={user.name}
              className="w-12 h-12 rounded-full border-2 border-[#1877F2] object-cover shadow-lg"
            />
            <div className="flex flex-col items-start">
              <span className="text-white font-bold text-[17px] drop-shadow-md flex items-center gap-1.5">
                {user.name}
                {user.is_verified === 1 && <VerifiedBadge size={14} />}
              </span>
              <span className="text-white/70 text-[12px] drop-shadow-md">
                {formatStoryTime(story.created_at)}
              </span>
            </div>
          </button>

          <div className="flex gap-2">
            <button
              onClick={(e) => { e.stopPropagation(); handleShare(); }}
              className="w-10 h-10 flex items-center justify-center bg-white/10 hover:bg-white/15 rounded-full"
              aria-label="Share story"
              title={copied ? 'Link copied!' : 'Share'}
            >
              {copied ? <AlertCircle size={18} className="text-emerald-400" /> : <Share2 size={18} className="text-white/80" />}
            </button>
            {isAuthor && onDeleteStory && (
              <button
                onClick={(e) => { e.stopPropagation(); setShowDeleteConfirm(true); }}
                className="w-10 h-10 flex items-center justify-center bg-[#F3425F]/80 hover:bg-[#F3425F] rounded-full"
                aria-label="Delete story"
                disabled={deletingStory}
              >
                <Trash2 size={18} className="text-white/90" />
              </button>
            )}
          </div>
        </div>

        <div className="flex-1 bg-[#0B1120] relative">
          <div className="absolute inset-0 z-[10] flex items-center justify-center">
            {storyIsText ? (
              <div
                className="w-full h-full flex items-center justify-center p-10 text-center"
                style={{ background: story.background_style || '#0B1120' }}
              >
                <div
                  className="text-white font-bold text-3xl sm:text-4xl drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] whitespace-pre-wrap break-words max-w-full"
                  onClick={(e) => e.stopPropagation()}
                >
                  <Linkify text={story.text_content || ''} />
                </div>
              </div>
            ) : displayUrl ? (
              <img
                src={displayUrl}
                alt="Story"
                className={`w-full h-full object-contain transition-opacity duration-300 ${
                  originalLoaded ? 'opacity-100' : 'opacity-95'
                }`}
                onLoad={() => setMediaReady(true)}
                onError={() => setMediaReady(true)}
              />
            ) : (
              <div className="w-full h-full flex items-center justify-center">
                <span className="text-white/50 text-sm">Media unavailable</span>
              </div>
            )}
          </div>
        </div>

        <div
          className="absolute bottom-0 left-0 right-0 p-3 pb-6 z-20 bg-gradient-to-t from-[#0B1120] via-[#0B1120]/80 to-transparent pt-10"
          data-no-nav="true"
        >
          <div className="flex items-center justify-between px-2">
            <div className="flex items-center gap-2 text-white/80">
              <Eye size={18} />
              <span className="text-[15px] font-semibold">{fmtCount(totalViews)}</span>
              <span className="text-[13px] text-white/60">
                {totalViews === 1 ? 'view' : 'views'}
              </span>
            </div>
            <button
              onClick={(e) => { e.stopPropagation(); handleShare(); }}
              className="flex items-center gap-1.5 h-10 px-3 rounded-lg hover:bg-white/10 transition-all"
              aria-label="Share"
            >
              <Share2 size={18} className="text-white" />
              <span className="text-[14px] font-semibold text-white">Share</span>
            </button>
          </div>
        </div>

        {showDeleteConfirm && (
          <div className="absolute inset-0 z-[500] bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
            <div className="w-full max-w-[400px] bg-[#0F172A] rounded-2xl border border-[#1E293B] shadow-2xl overflow-hidden">
              <div className="flex items-center justify-between px-4 py-3 border-b border-[#1E293B]">
                <div className="flex items-center gap-2">
                  <Trash2 size={16} className="text-[#F3425F]" />
                  <h3 className="text-white font-bold text-base">Delete Story</h3>
                </div>
                <button
                  onClick={() => setShowDeleteConfirm(false)}
                  className="w-9 h-9 rounded-full bg-white/10 hover:bg-white/15 flex items-center justify-center"
                  disabled={deletingStory}
                >
                  <X size={16} className="text-white/80" />
                </button>
              </div>
              <div className="p-6">
                <p className="text-white font-bold text-center text-lg mb-2">Delete this story?</p>
                <p className="text-white/60 text-center text-sm mb-6">
                  This story will be permanently deleted. This action cannot be undone.
                </p>
                <div className="flex gap-3">
                  <button
                    onClick={() => setShowDeleteConfirm(false)}
                    className="flex-1 py-3 rounded-xl bg-white/10 hover:bg-white/15 text-white font-bold transition-all"
                    disabled={deletingStory}
                  >Cancel</button>
                  <button
                    onClick={handleDeleteStory}
                    className="flex-1 py-3 rounded-xl bg-[#F3425F] hover:bg-[#E41E3F] text-white font-bold transition-all flex items-center justify-center gap-2"
                    disabled={deletingStory || deleteLoading}
                  >
                    {deletingStory || deleteLoading ? <Loader2 size={16} className="animate-spin" /> : <Trash2 size={16} />}
                    Delete
                  </button>
                </div>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  );
};

